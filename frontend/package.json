{
    "name": "umineko-city-of-books",
    "version": "7.2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build",
        "build:app": "tsc -b && vite build --mode app --outDir dist-app --emptyOutDir",
        "build:ota": "npm run build:app && node scripts/make-ota.mjs",
        "cap:sync": "npm run build:app && cap sync",
        "cap:android": "npm run build:app && cap sync android && cap open android",
        "cap:local": "node scripts/cap-local.mjs",
        "assets": "npx @capacitor/assets@latest generate --android --iconBackgroundColor \"#0A0612\" --iconBackgroundColorDark \"#0A0612\" --splashBackgroundColor \"#0A0612\" --splashBackgroundColorDark \"#0A0612\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:names": "node scripts/test-names.mjs",
        "typecheck": "tsc -b",
        "preview": "vite preview",
        "lint": "oxlint --max-warnings=0 --disable-nested-config .",
        "lint:fix": "oxlint --disable-nested-config . --fix",
        "format": "oxfmt --check ./src",
        "format:fix": "oxfmt ./src"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.0",
        "@capacitor/app": "^8.1.1",
        "@capacitor/cli": "^8.5.0",
        "@capacitor/core": "^8.5.0",
        "@capacitor/ios": "^8.5.0",
        "@capacitor/preferences": "^8.0.1",
        "@capacitor/push-notifications": "^8.1.2",
        "@capacitor/splash-screen": "^8.0.2",
        "@capacitor/status-bar": "^8.0.3",
        "@capgo/capacitor-updater": "^8.51.3",
        "@hyperbeam/web": "^0.0.38",
        "@livekit/components-react": "^2.9.24",
        "@marsidev/react-turnstile": "^1.6.1",
        "@tanstack/react-query": "^5.102.8",
        "@tiptap/extension-color": "^3.29.2",
        "@tiptap/extension-link": "^3.29.2",
        "@tiptap/extension-placeholder": "^3.29.2",
        "@tiptap/extension-text-align": "^3.29.2",
        "@tiptap/extension-text-style": "^3.29.2",
        "@tiptap/pm": "^3.29.2",
        "@tiptap/react": "^3.29.2",
        "@tiptap/starter-kit": "^3.29.2",
        "chess.js": "^1.4.0",
        "dompurify": "^3.4.14",
        "emoji-picker-react": "^4.19.1",
        "firebase": "^12.18.0",
        "highlight.js": "^11.12.0",
        "hls.js": "^1.6.16",
        "livekit-client": "^2.22.0",
        "marked": "^18.0.11",
        "react": "^19.2.8",
        "react-chessboard": "^5.12.1",
        "react-dom": "^19.2.8",
        "react-router": "^8.3.0"
    },
    "devDependencies": {
        "@capgo/cli": "^8.36.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/coverage-v8": "^4.1.11",
        "jsdom": "^30.0.1",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "allowScripts": {
        "cbor-extract@2.2.2": true,
        "@firebase/util@1.15.3": true,
        "node-pty@1.1.0": true,
        "protobufjs@7.6.6": true
    }
}
