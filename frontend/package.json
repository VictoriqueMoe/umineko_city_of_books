{
    "name": "umineko-city-of-books",
    "private": true,
    "version": "7.2.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "build:app": "tsc -b && vite build --mode app --outDir dist-app --emptyOutDir",
        "build:ota": "npm run build:app && node scripts/make-ota.mjs",
        "cap:sync": "npm run build:app && cap sync",
        "cap:android": "npm run build:app && cap sync android && cap open android",
        "cap:local": "node scripts/cap-local.mjs",
        "assets": "npx @capacitor/assets@latest generate --android --iconBackgroundColor \"#0A0612\" --iconBackgroundColorDark \"#0A0612\" --splashBackgroundColor \"#0A0612\" --splashBackgroundColorDark \"#0A0612\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc -b",
        "preview": "vite preview",
        "lint": "eslint --max-warnings=0 .",
        "lint:fix": "eslint . --fix",
        "prettier": "prettier ./src --check",
        "prettier:fix": "prettier ./src --write"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.0",
        "@capacitor/app": "^8.1.1",
        "@capacitor/cli": "^8.5.0",
        "@capacitor/core": "^8.5.0",
        "@capacitor/ios": "^8.5.0",
        "@capacitor/preferences": "^8.0.1",
        "@capacitor/push-notifications": "^8.1.2",
        "@capacitor/splash-screen": "^8.0.2",
        "@capacitor/status-bar": "^8.0.3",
        "@capgo/capacitor-updater": "^8.51.3",
        "@hyperbeam/web": "^0.0.38",
        "@livekit/components-react": "^2.9.23",
        "@marsidev/react-turnstile": "^1.5.3",
        "@tanstack/react-query": "^5.101.4",
        "@tiptap/extension-color": "^3.29.2",
        "@tiptap/extension-link": "^3.29.2",
        "@tiptap/extension-placeholder": "^3.29.2",
        "@tiptap/extension-text-align": "^3.29.2",
        "@tiptap/extension-text-style": "^3.29.2",
        "@tiptap/pm": "^3.29.2",
        "@tiptap/react": "^3.29.2",
        "@tiptap/starter-kit": "^3.29.2",
        "chess.js": "^1.4.0",
        "dompurify": "^3.4.13",
        "emoji-picker-react": "^4.19.1",
        "highlight.js": "^11.11.1",
        "hls.js": "^1.6.16",
        "livekit-client": "^2.21.0",
        "marked": "^18.0.9",
        "react": "^19.2.8",
        "react-chessboard": "^5.12.0",
        "react-dom": "^19.2.8",
        "react-router": "^8.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/coverage-v8": "^4.1.10",
        "adm-zip": "^0.6.0",
        "eslint": "^10.8.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
    },
    "allowScripts": {
        "cbor-extract@2.2.2": true
    }
}
